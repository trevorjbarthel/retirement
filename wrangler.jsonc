{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "military-transition-calc",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "retirement.airforcehub.com", "custom_domain": true }
  ],

  // Serve the front-end (public/) via Workers Static Assets.
  // run_worker_first ensures /api/* always invokes the Worker before asset matching;
  // every other path is served edge-direct from public/ (fast, no Worker cost).
  //
  // The calendar feed must be listed too. Without it the SPA fallback answers
  // /p/<id>/calendar.ics with index.html — a calendar client would subscribe successfully
  // and then silently receive HTML forever, which is worse than a clean failure.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*/calendar.ics"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtc-db",
      "database_id": "21441f9b-b130-4190-bc7d-3ae8477b9f33",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_ENV": "production"
  },

  // Per-IP throttles to blunt abuse. Active only when APP_ENV != "development" (so
  // local dev / tests skip them). CREATE_LIMITER guards POST /api/p (new plans);
  // UPDATE_LIMITER guards PUT /api/p/:id (edits) and is more generous since a single
  // legitimate editing session makes many small debounced saves.
  "unsafe": {
    "bindings": [
      {
        "name": "CREATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      },
      {
        "name": "UPDATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  }
}
